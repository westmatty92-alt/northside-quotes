{
  "permissions": {
    "deny": [
      "Bash(node scripts/stack-ledger.mjs gate resolve:*)",
      "Bash(npm run ledger -- gate resolve:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(vercel env pull:*)",
      "Bash(vercel env add:*)",
      "Bash(vercel env rm:*)",
      "Bash(vercel env update:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel promote:*)",
      "Bash(vercel rollback:*)",
      "Bash(npx vercel env pull:*)",
      "Bash(npx vercel --prod:*)",
      "Bash(npx vercel deploy --prod:*)",
      "Bash(npx vercel promote:*)",
      "Bash(npx vercel rollback:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh variable set:*)",
      "Bash(gh variable delete:*)",
      "Bash(terraform apply:*)",
      "Bash(tofu apply:*)",
      "Bash(printenv:*)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.development)",
      "mcp__vercel__deploy_to_vercel",
      "mcp__vercel__buy_domain",
      "Bash(gh workflow run release:*)",
      "Bash(gh workflow run .github/workflows/release:*)",
      "Bash(vercel deploy --prebuilt --prod:*)",
      "Bash(npx --no-install supabase db push:*)"
    ],
    "allow": [
      "Bash(node scripts/*)",
      "Bash(npm ci)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx orval*)",
      "Bash(npx --yes @google/design.md *)",
      "Bash(npx --yes @redocly/cli *)",
      "Bash(npx --no-install supabase start*)",
      "Bash(npx --no-install supabase status*)",
      "Bash(npx --no-install supabase stop*)",
      "Bash(npx --no-install supabase test db*)",
      "Bash(npx --no-install supabase migration new *)",
      "Bash(npx --no-install supabase gen types *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Bash(git rev-parse*)",
      "WebFetch"
    ],
    "$comment": "allow (approved by Matthew, Nov 19 2026, full-team rehearsal): the build/test/lint/commit commands specialists need when they run in the background, where nobody can click an approval. deny always wins over allow, and the prod-guard and specialist-scope hooks still run on every call. No grep/cat/ls/printenv: from the shell they can read .env files; agents use the Read/Grep/Glob tools, which the deny list covers."
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/mode-check.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/prod-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/orchestrator-scope.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/specialist-scope.mjs\""
          }
        ]
      }
    ]
  }
}
