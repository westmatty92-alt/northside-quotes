{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/app/**/{page,layout,route,loading,error,not-found}.{ts,tsx}", "src/proxy.ts", "scripts/*.mjs"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
  "ignore": ["src/lib/api/generated/**", "src/types/database.ts", "src/mocks/**"],
  "ignoreDependencies": ["server-only"]
}
