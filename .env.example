# Copy to .env.local (git-ignored). Never commit real values. Names only below.
# infra/environments.json is the list of record; `node scripts/env-check.mjs --manifest-only` keeps this file in step with it.
# Baseleap ledger (the Console database). Deliberately NOT named SUPABASE_*: the app you're
# building has its own Supabase, and its keys use those names. Mixing them up would point
# the app at the Console, or the ledger at the app.
BASELEAP_LEDGER_URL=https://qqgdzwkbuzciocnyimje.supabase.co
BASELEAP_LEDGER_SERVICE_KEY=
BASELEAP_LEDGER_ANON_KEY=
BASELEAP_OPERATOR_ID=
BASELEAP_OPERATOR_EMAIL=

# ---- App: Vercel variables (docs/architecture.md "Environment variables"). Set by Matthew in Vercel, Production and Preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Read only in src/lib/server/admin.ts (SECURITY_MODEL invariant 2).
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=
# Server-only, at least 32 characters, a different value in each environment; read only in src/lib/server/env.ts
# (invariant 15). Vercel only: never GitHub, never an agent machine. env-check fails if either is missing (SEC-4).
APP_SIGNING_SECRET=
CRON_SECRET=
# Server-only; read only in src/lib/server/integrations/ghl/client.ts (invariant 9). Test sub-account token, later.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
# Optional; tests point it at a stub. Never set in Production (ignored there).
GHL_API_BASE_URL=
# VERCEL_ENV and VERCEL_GIT_COMMIT_SHA are Vercel system variables: never set them (not even empty) anywhere.

# ---- Orchestrator machine only (migrations, RLS tests, type generation): never the app, never Vercel.
# The Session pooler string from the staging project's dashboard (Connect > Session pooler), password filled in.
# Also a secret in the GitHub `staging` environment.
SUPABASE_STAGING_DB_URL=
# Optional guards read by supabase/scripts/db.mjs: require the staging ref; refuse a URL naming production.
SUPABASE_STAGING_REF=
SUPABASE_PROD_PROJECT_REF=

# ---- CI: GitHub `staging` environment (secrets and variables), also used by QA from .env.local.
# Protection Bypass for Automation secret from the Vercel project (staging previews only).
VERCEL_AUTOMATION_BYPASS_SECRET=
# Staging Supabase project keys, for the tests (never the production project).
SUPABASE_STAGING_URL=
SUPABASE_STAGING_ANON_KEY=
SUPABASE_STAGING_SERVICE_ROLE_KEY=
# Production hostnames QA tooling must refuse, e.g. northside-quotes.vercel.app
PRODUCTION_HOSTS=
# QA's base URL: the staging preview. qa-smoke.yml sets it in CI; QA sets it in .env.local.
STAGING_URL=
# Staging owner and helper test logins (QA names; QA confirms). Staging only.
QA_OWNER_EMAIL=
QA_OWNER_PASSWORD=
QA_HELPER_EMAIL=
QA_HELPER_PASSWORD=

# ---- CI: GitHub `production` environment and repository variable. Never on an agent machine, never in Vercel.
# Production session-pooler string with the password filled in. Only the approved release workflow reads it.
SUPABASE_PRODUCTION_DB_URL=
# Vercel release token (team baseleap only, 30-day expiry) and the Vercel team and project ids.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Repository variable: the production address that release.yml and uptime.yml check.
PRODUCTION_URL=
