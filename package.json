{
  "name": "northside-quotes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:offline": "vitest run src/ tests/unit/ tests/integrations/ --exclude 'tests/integrations/**/db.test.ts'",
    "gen:types": "node --env-file-if-exists=.env.local supabase/scripts/db.mjs types && orval",
    "mock": "npx --yes @stoplight/prism-cli@5 mock docs/openapi.yaml",
    "db:migrate": "node --env-file-if-exists=.env.local supabase/scripts/db.mjs migrate",
    "db:test": "node --env-file-if-exists=.env.local supabase/scripts/db.mjs test",
    "db:check": "node --env-file-if-exists=.env.local supabase/scripts/db.mjs check",
    "db:staff-add": "node --env-file-if-exists=.env.local supabase/scripts/db.mjs staff-add",
    "db:test:local": "node supabase/scripts/db.mjs test --local",
    "db:check:local": "node supabase/scripts/db.mjs check --local",
    "gen:types:local": "node supabase/scripts/db.mjs types --local && orval"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.1",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@mswjs/interceptors": "^0.45.12",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "orval": "^8.48.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
